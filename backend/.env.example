APP_NAME=Digital Export Manager API
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=your-secure-secret-key-min-32-characters-abc123
DATABASE_URL=sqlite:///./nile_key.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
ALLOWED_ORIGINS=["http://localhost:3000", "https://nile-key.com"]
LETME_API_ID=your-letme-id
LETME_API_PASSWORD=your-letme-password
SENDCLOUD_PUBLIC_KEY=your-sendcloud-public-key
SENDCLOUD_SECRET_KEY=your-sendcloud-secret-key
ETA_CLIENT_ID=your-eta-client-id
ETA_CLIENT_SECRET=your-eta-client-secret
ETA_BASE_URL=https://api.invoicing.eta.gov.eg
OWNER_PASSWORD=your-owner-password-min-8-characters
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@nile-key.com
SMTP_USE_TLS=True
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ========== Moaah External Source Adapter (WP-38a Task 2) ==========
MOAAH_BASE_URL=https://your-moaah-api.example.com
MOAAH_API_KEY=your-moaah-api-key
MOAAH_TIMEOUT_SECONDS=10.0
MOAAH_SOURCE_ID=moaah
MOAAH_SOURCE_NAME=Moaah External Knowledge
MOAAH_SOURCE_TYPE=external
MOAAH_SOURCE_VERSION=1.0.0

# ========== TradeData External Source Adapter (WP-38b Task 2) ==========
TRADEDATA_BASE_URL=https://api.tradedata.io
